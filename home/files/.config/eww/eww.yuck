		:halign "center"
		:space-evenly "false"
		:spacing 16
		
		(box	:orientation "h"
			:space-evenly "false"
		
			(label :text "CPU_0: " :class "varlabel")
			(label :text {stats.cpu0})
		)
		
		(box	:orientation "h"
			:space-evenly "false"
		
			(label :text "CPU_1: " :class "varlabel")
			(label :text {stats.cpu1})
		)
		
		(box	:orientation "h"
			:space-evenly "false"
		
			(label :text "CPU_2: " :class "varlabel")
			(label :text {stats.cpu2})
		)
		
		(box	:orientation "h"
			:space-evenly "false"
		
			(label :text "CPU_3: " :class "varlabel")
			(label :text {stats.cpu3})
		)

	)		
)

(defwidget core-temp-widget []
	(box	:orientation "h"
		:halign "center"
		:spacing 16

		(box	:orientation "h"
			:space-evenly "false"
			
			(label :text "CORE0_TMP: " :class "varlabel")
			(label :text {stats.temp0})

		)
		(box	:orientation "h"
			:space-evenly "false"
			
			(label :text "CORE1_TMP: " :class "varlabel")
			(label :text {stats.temp1})
		)
	)		
)
	
(defwidget os-info-widget []
	(box	:orientation "h"
		:halign "center"
		:space-evenly "false"
		:spacing 16

		(box	:orientation "h"
			:space-evenly "false"

			(label :text "NAME: " :class "varlabel")
			(label :text kernel-name-poll)
		)
		
		(box	:orientation "h"
			:space-evenly "false"

			(label :text "RELEASE: " :class "varlabel")
			(label :text kernel-release-poll)
		)

	)
)

(defwidget sysinfo-widget []
	(box 	:orientation "v"
		:halign "center"
		:valign "start"
		:space-evenly false
		:class "sysinfo-box"
	
		(show-workspace-widget)
		(os-info-widget)
		(uptime-widget)
		(cpu-bar-widget)
		(core-temp-widget)
		(mem-bar-widget)
		(net-widget)
		(box	:orientation "h"
			:space-evenly "false"
			:class "nameinfo"
			:halign "center"
			
			(label :text "[ ")
			(label :text name-poll)
			(label :text " ]")
		)
	)
)

(defwindow sysinfo
	:monitor 0
	:geometry 	(geometry 	:x "10px" 
					:y "10px" 
					:width "600px" 
					:height "30px" 
					:anchor "center center"
			)
	:stacking "bg"
	:focusable false
	:wm-ignore true
	:windowtype "desktop"
	:exclusive false
	(sysinfo-widget)
)

;; A right-edge exclusive surface gives the command pane its own space;
;; minde reflows the current frame tree when it opens or closes.
(defwidget actions-widget []
	(box :orientation "v" :space-evenly false :spacing 24 :class "actions-box"
		(box :orientation "h" :space-evenly false
			(box :orientation "v" :space-evenly false :spacing 4 :hexpand true
				(label :class "actions-title" :halign "start" :text "操作")
				(label :class "actions-subtitle" :halign "start" :text "[ COMMANDS ]"))
			(button :class "actions-close" :tooltip "Close (Print a)"
				:onclick "${EWW_CMD} close actions" "×"))
		(box :orientation "v" :space-evenly false :spacing 8
			(label :class "actions-heading" :halign "start" :text "01 / DESKTOP")
			(button :class "action-button"
				:onclick "${EWW_CMD} close actions; mindectl eval '(next-wallpaper!)'"
				(label :halign "start" :text "Change wallpaper")))
		(box :orientation "v" :space-evenly false :spacing 8
			(label :class "actions-heading" :halign "start" :text "02 / GUIX")
			(button :class "action-button"
				:onclick "${EWW_CMD} close actions; foot --hold -e make -C /home/samuel/Projects/System reconfigure-home"
				(label :halign "start" :text "Reconfigure home"))
			(button :class "action-button"
				:onclick "${EWW_CMD} close actions; foot --hold -e make -C /home/samuel/Projects/System reconfigure-system"
				(label :halign "start" :text "Reconfigure system")))
		(box :orientation "v" :space-evenly false :spacing 8
			(label :class "actions-heading" :halign "start" :text "03 / HARDWARE")
			(button :class "action-button"
				:tooltip "Unbind/bind the i8042 controller (Print K)"
				:onclick "${EWW_CMD} close actions; sudo -n /run/current-system/profile/bin/guile -s /home/samuel/Projects/System/scripts/toggle-internal-keyboard.scm && notify-send 'Internal keyboard' toggled"
				(label :halign "start" :text "Toggle internal keyboard"))
			(button :class "action-button"
				:tooltip "Put the mouse in pairing mode first"
				:onclick "${EWW_CMD} close actions; /home/samuel/Projects/System/scripts/pair-ergo-mouse.scm"
				(label :halign "start" :text "Re-pair ERGO mouse")))
		(box :orientation "v" :space-evenly false :spacing 8
			(label :class "actions-heading" :halign "start" :text "04 / SESSION")
			(button :class "action-button"
				:onclick "${EWW_CMD} close actions; mindectl eval '(lock-screen!)'"
				(label :halign "start" :text "Lock"))
			(button :class "action-button"
				:onclick "${EWW_CMD} close actions; mindectl eval '(suspend!)'"
				(label :halign "start" :text "Suspend"))
			(button :class "action-button action-power"
				:onclick "${EWW_CMD} close actions; loginctl reboot"
				(label :halign "start" :text "Reboot"))
			(button :class "action-button action-power"
				:onclick "${EWW_CMD} close actions; loginctl poweroff"
				(label :halign "start" :text "Shutdown")))
		(box :vexpand true)
		(label :class "actions-hint" :halign "start" :text "Print a · close"))
)

;; Minde supplies usable output height, accounting for the bar's exclusive zone.
(defwindow actions [pane-height]
	:monitor 0
	:namespace "eww-actions"
	:geometry (geometry :x "0" :y "0" :width "20%" :height "${pane-height}px"
		:anchor "center right")
	:stacking "fg"
	:exclusive true
	(actions-widget)
)

;; ---- minde top bar ----
;; minde publishes a JSON status document (groups, focused window,
;; outputs) on every change; `mindectl subscribe --json` prints the
;; current document once and then one line per update.  The group
;; names become buttons that switch groups through `mindectl eval`.
;; The exclusive zone makes minde's frame tree tile below the bar
;; automatically.  Same daemon as sysinfo: `eww open bar` /
;; `eww open sysinfo` coexist.

(deflisten minde-state
	:initial "{\"groups\":[],\"focused_window\":null}"
	"mindectl subscribe --json 2>/dev/null")

(defwidget group-buttons []
	(box :class "groups" :space-evenly false :spacing 2
		(for g in {minde-state.groups}
			(button :class {g.focused ? "group focused" : "group"}
				:onclick "mindectl eval '(switch-to-group! \"${g.name}\")'"
				{g.focused ? "[${g.name}]" : g.name})))
)

(defwindow bar
	:monitor 0
	:geometry 	(geometry 	:x "0"
					:y "0"
					:width "100%"
					:height "32px"
					:anchor "top center"
			)
	:stacking "fg"
	:exclusive true
	(centerbox
		(box :halign "start" :class "minde-status" :space-evenly false :spacing 8
			(group-buttons)
			(label :text "|")
			(label :text {minde-state.focused_window?.title ?: ""}))
		(box)
		(box :halign "end" :space-evenly false :spacing 12
			(label :class "bar-bat" :text {stats.bat})
			(label :class "bar-clock" :text {stats.clock}))
	)
)
